{"nodes": [{"id": "backtest_walk_forward", "label": "Walk-forward replay", "file_type": "rationale", "source_file": "evaluation/backtest.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A snapshot answers 'what would we allocate now' but not 'what would this policy have cost over an hour and how often would it have failed'. Only replay can, and replay is the difference between a projected saving and a measured one. At each step the policy sees ONLY prior rows, then is charged for the following horizon."}, {"id": "backtest_run", "label": "run (replay one target)", "file_type": "code", "source_file": "evaluation/backtest.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backtest_policy_static", "label": "policy_static (100%)", "file_type": "code", "source_file": "evaluation/backtest.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backtest_policy_reactive_p95", "label": "policy_reactive_p95 (no model control)", "file_type": "code", "source_file": "evaluation/backtest.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses no model whatsoever. It is the control that shows how much of any saving comes from the allocation policy rather than from forecasting."}, {"id": "backtest_policy_predictive", "label": "policy_predictive", "file_type": "code", "source_file": "evaluation/backtest.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backtest_policy_predictive_nofloor", "label": "policy_predictive_nofloor", "file_type": "code", "source_file": "evaluation/backtest.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Identical to predictive minus the safety floor, purely to price what the floor costs."}, {"id": "backtest_policy_oracle", "label": "policy_oracle (perfect foresight)", "file_type": "code", "source_file": "evaluation/backtest.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unachievable by construction; it bounds how much value forecasting could ever add. The gap reactive_p95 -> predictive is the model's contribution; predictive -> oracle is what a perfect model would add."}, {"id": "backtest_forecast_from_history", "label": "_forecast_from_history", "file_type": "code", "source_file": "evaluation/backtest.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backtest_fit", "label": "_fit (in-replay refit)", "file_type": "code", "source_file": "evaluation/backtest.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backtest_combined", "label": "combined (whole-node aggregate)", "file_type": "code", "source_file": "evaluation/backtest.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Breach rate is the WORST across resources, never pooled. Pooling let memory's zero breaches dilute CPU's failures: an earlier version reported the node at 2.58% and SLA-compliant while CPU alone breached 7.73%. An SLA is violated when any one resource violates it."}], "edges": [{"source": "backtest_run", "target": "backtest_forecast_from_history", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "evaluation/backtest.py", "source_location": null, "weight": 1.0}, {"source": "backtest_run", "target": "backtest_fit", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "evaluation/backtest.py", "source_location": null, "weight": 1.0}, {"source": "backtest_run", "target": "cost_model_breach_stats", "rel