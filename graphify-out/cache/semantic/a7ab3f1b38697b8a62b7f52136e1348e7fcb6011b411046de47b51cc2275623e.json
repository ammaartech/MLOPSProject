{"nodes": [{"id": "predictor_resolve_champion", "label": "resolve_champion", "file_type": "code", "source_file": "serving/predictor.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "predictor_predict", "label": "predict (single step)", "file_type": "code", "source_file": "serving/predictor.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "predictor_forecast_horizon", "label": "forecast_horizon (iterative multi-step)", "file_type": "code", "source_file": "serving/predictor.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each step feeds the previous prediction back as the new current value, so error compounds visibly rather than being hidden. With a persistence champion the trajectory is flat by construction - persistence genuinely has no forward opinion, and inventing one would fake confidence the measurement does not support."}, {"id": "predictor_log_prediction", "label": "log_prediction", "file_type": "code", "source_file": "serving/predictor.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "predictor_score", "label": "score (actual backfill)", "file_type": "code", "source_file": "serving/predictor.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Matched on exact timestamp: a prediction about a moment the collector never recorded stays unscored rather than being matched to a neighbouring sample."}, {"id": "predictor_backfill", "label": "backfill (replay champion over history)", "file_type": "code", "source_file": "serving/predictor.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The drift monitor expects one prediction per sample, but the backtest logs one per horizon-length DECISION, which is far too sparse to reach drift.min_samples. Backfill reconstructs what the prediction log would have looked like had the champion been serving all along. Only rows inside a segment are predicted."}, {"id": "predictor_recent_predictions", "label": "recent_predictions", "file_type": "code", "source_file": "serving/predictor.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "predictor_predictions_table", "label": "predictions table (prediction log)", "file_type": "code", "source_file": "serving/predictor.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without a logged prediction/actual/abs_error table, 'the model is getting worse' is a feeling rather than a measurement."}, {"id": "predictor_feature_version_enforcement", "label": "Feature-version enforcement at serving", "file_type": "rationale", "source_file": "serving/predictor.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If the online store holds a different feature version than the champion was trained on, serving REFUSES rather than predicting from mismatched inputs. Training-serving skew is otherwise invisible: the numbers still look plausible."}, {"id": "predictor_baseline_is_not_degraded", "label": "Serving a baseline is a legitimate production state", "file_type": "rationale", "source_file": "serving/predictor.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The gate rejected every gradient booster, so persistence is champion for all three resources. Trained estimators and baselines are served through one interface because the consumer only asks 'what will this resource be next'; which predictor answers is a registry implementation detail."}], "edges": [{"source": "predictor_resolve_champion", "target": "mlflow_tracker_baseline_prefix", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "serving/predictor.py", "source_location": null, "weight": 1.0}, {"source": "predictor_resolve_champion", "target": "mlflow_tracker_registry", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "serving/predictor.py", "source_location": null, "weight": 1.0}, {"source": "predictor_predict", "target": "predictor_resolve_champion", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "serving/predictor.py", "source_location": null, "weight": 1.0}, {"source": "predictor_predict", "target": "predictor_log_prediction", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "serving/predictor.py", "source_location": null, "weight": 1.0}, {"source": "predictor_predict", "target": "predictor_feature_version_enforcement", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "serving/predictor.py", "source_location": null, "weight": 1.0}, {"source": "predictor_forecast_horizon", "target": "predictor_resolve_champion", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "serving/predictor.py", "source_location": null, "weight": 1.0}, {"source": "predictor_log_prediction", "target": "predictor_predictions_table", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "serving/predictor.py", "source_location": null, "weight": 1.0}, {"source": "predictor_score", "target": "predictor_predictions_table", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "serving/predictor.py", "source_location": null, "weight": 1.0}, {"source": "predictor_backfill", "target": "predictor_resolve_champion", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "serving/predictor.py", "source_location": null, "weight": 1.0}, {"source": "predictor_backfill", "target": "drift_rolling_error", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "serving/predictor.py", "source_location": null, "weight": 1.0}, {"source": "predictor_baseline_is_not_degraded", "target": "predictor_predict", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "serving/predictor.py", "source_location": null, "weight": 1.0}], "hyperedges": []}