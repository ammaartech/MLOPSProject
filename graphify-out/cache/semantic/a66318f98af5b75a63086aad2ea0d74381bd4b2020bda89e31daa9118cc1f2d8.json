{"nodes": [{"id": "drift_two_signals", "label": "Two independent drift signals", "file_type": "rationale", "source_file": "serving/drift.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Performance drift is what matters but needs labels, arriving a horizon late and never at all if the collector stops. Feature drift (PSI) is label-free and immediate but a shifted input distribution does not always hurt accuracy. Performance drift decides; feature drift is the early warning."}, {"id": "drift_psi", "label": "psi (Population Stability Index)", "file_type": "code", "source_file": "serving/drift.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bin edges come from the REFERENCE distribution because the question is how new data sits against what the model learned. A small floor on zero shares keeps the log term finite."}, {"id": "drift_feature_drift", "label": "feature_drift", "file_type": "code", "source_file": "serving/drift.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "drift_rolling_error", "label": "rolling_error", "file_type": "code", "source_file": "serving/drift.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "drift_check", "label": "check (drift decision)", "file_type": "code", "source_file": "serving/drift.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A champion with a perfect training score (constant series) has no ratio to compute, so any sustained error at all becomes the signal instead."}, {"id": "drift_monitor", "label": "monitor", "file_type": "code", "source_file": "serving/drift.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "drift_retrain", "label": "retrain (drift-triggered)", "file_type": "code", "source_file": "serving/drift.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drift triggers a retrain, it does not authorise a deployment. The retrained model faces the same promotion gate as any other challenger."}, {"id": "drift_events_table", "label": "drift_events record", "file_type": "code", "source_file": "serving/drift.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "drift_rolling_error", "target": "predictor_recent_predictions", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "serving/drift.py", "source_location": null, "weight": 1.0}, {"source": "drift_check", "target": "drift_rolling_error", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "serving/drift.py", "source_location": null, "weight": 1.0}, {"source": "drift_check", "target": "drift_feature_drift", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "serving/drift.py", "source_location": null, "weight": 1.0}, {"source": "drift_check", "target": "predictor_resolve_champion", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "serving/drift.py", "source_location": null, "weight": 1.0}, {"source": "drift_feature_drift", "target": "drift_psi", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "serving/drift.py", "source_location": null, "weight": 1.0}, {"source": "drift_monitor", "target": "drift_check", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "serving/drift.py", "source_location": null, "weight": 1.0}, {"source": "drift_monitor", "target": "drift_events_table", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "serving/drift.py", "source_location": null, "weight": 1.0}, {"source": "drift_monitor", "target": "drift_retrain", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "serving/drift.py", "source_location": null, "weight": 1.0}, {"source": "drift_retrain", "target": "mlflow_tracker_run_gate", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "serving/drift.py", "source_location": null, "weight": 1.0}, {"source": "drift_two_signals", "target": "drift_check", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "serving/drift.py", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "closed_loop_serving", "label": "Predict -> log -> score -> drift -> retrain -> re-gate", "nodes": ["predictor_predict", "predictor_log_prediction", "predictor_score", "predictor_predictions_table", "drift_check", "drift_retrain", "mlflow_tracker_run_gate"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "serving/drift.py"}]}