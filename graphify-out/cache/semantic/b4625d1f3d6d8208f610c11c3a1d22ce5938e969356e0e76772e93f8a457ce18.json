{"nodes": [{"id": "mlflow_tracker_promotion_gate", "label": "Promotion Gate", "file_type": "rationale", "source_file": "tracking/mlflow_tracker.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A challenger is promoted only if it beats the strongest baseline on the same test window, survives rolling-origin CV (min_cv_folds_won), keeps fold-to-fold spread within max_cv_std_ratio of the baseline, and improves on the incumbent by min_improvement_pct. Rejecting is the gate working, not failing: a model worse than a trivial rule must not serve traffic, and churning the champion on noise is worse than leaving it alone."}, {"id": "mlflow_tracker_run_gate", "label": "run_gate", "file_type": "code", "source_file": "tracking/mlflow_tracker.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "mlflow_tracker_evaluate", "label": "evaluate (gate decision)", "file_type": "code", "source_file": "tracking/mlflow_tracker.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "mlflow_tracker_log_training_run", "label": "log_training_run", "file_type": "code", "source_file": "tracking/mlflow_tracker.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "mlflow_tracker_current_champion", "label": "current_champion", "file_type": "code", "source_file": "tracking/mlflow_tracker.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "mlflow_tracker_promote", "label": "promote", "file_type": "code", "source_file": "tracking/mlflow_tracker.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "mlflow_tracker_promote_baseline", "label": "promote_baseline (persistence champion)", "file_type": "code", "source_file": "tracking/mlflow_tracker.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Production needs a defined predictor. An empty registry would let serving silently fall back to whatever was trained last. The baseline champion is also REFRESHED on every run, because persistence is re-measured each time and a stale reference would make the drift monitor report a changed baseline as drift."}, {"id": "mlflow_tracker_registry", "label": "Model registry (model_versions)", "file_type": "code", "source_file": "tracking/mlflow_tracker.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "mlflow_tracker_baseline_prefix", "label": "BASELINE_PREFIX marker", "file_type": "code", "source_file": "tracking/mlflow_tracker.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "mlflow_tracker_same_window_rescore", "label": "Same-window champion re-scoring", "file_type": "rationale", "source_file": "tracking/mlflow_tracker.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Comparing a challenger against a champion's STORED MAE compares across datasets: a model scoring 4.998 was rejected against a champion measured 4.726 on an older, easier window. Incumbents are now re-scored on this run's test window (champion_mae_same_window), with the stored figure as a flagged fallback."}], "edges": [{"source": "mlflow_tracker_run_gate", "target": "mlflow_tracker_log_training_run", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tracking/mlflow_tracker.py", "source_location": null, "weight": 1.0}, {"source": "mlflow_tracker_run_gate", "target": "mlflow_tracker_evaluate", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tracking/mlflow_tracker.py", "source_location": null, "weight": 1.0}, {"source": "mlflow_tracker_run_gate", "target": "mlflow_tracker_promote", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tracking/mlflow_tracker.py", "source_location": null, "weight": 1.0}, {"source": "mlflow_tracker_run_gate", "target": "mlflow_tracker_promote_baseline", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tracking/mlflow_tracker.py", "source_location": null, "weight": 1.0}, {"source": "mlflow_tracker_run_gate", "target": "mlflow_tracker_current_champion", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tracking/mlflow_tracker.py", "source_location": null, "weight": 1.0}, {"source": "mlflow_tracker_evaluate", "target": "mlflow_tracker_current_champion", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tracking/mlflow_tracker.py", "source_location": null, "weight": 1.0}, {"source": "mlflow_tracker_evaluate", "target": "mlflow_tracker_promotion_gate", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tracking/mlflow_tracker.py", "source_location": null, "weight": 1.0}, {"source": "mlflow_tracker_same_window_rescore", "target": "mlflow_tracker_evaluate", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tracking/mlflow_tracker.py", "source_location": null, "weight": 1.0}, {"source": "mlflow_tracker_evaluate", "target": "mlflow_tracker_baseline_prefix", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tracking/mlflow_tracker.py", "source_location": null, "weight": 1.0}, {"source": "mlflow_tracker_promote_baseline", "target": "mlflow_tracker_registry", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tracking/mlflow_tracker.py", "source_location": null, "weight": 1.0}, {"source": "mlflow_t