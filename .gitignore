# ======================================================================
#  What does not belong in version control.
#
#  The rule this file applies: track what DEFINES the system, not what
#  the system PRODUCES. Every path below is either reinstallable from
#  requirements.txt or regenerable by running the pipeline.
# ======================================================================

# ---------------------------------------------------------------- python
# The virtualenv is Windows-specific (pywin32 .pyd binaries, absolute
# paths baked into Scripts/*.exe) and reinstallable in one command:
#     python -m venv .venv
#     .\.venv\Scripts\python.exe -m pip install -r requirements.txt
.venv/
venv/
env/
.deps_ok

__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ipynb_checkpoints/
build/
dist/
*.egg-info/

# ------------------------------------------------------------- runtime
# The data plane. metrics.db alone is ~80 MB and changes on every single
# pipeline run, so committing it means an 80 MB binary diff per run that
# git cannot compress meaningfully.
#
# NOTE: this is the collected evidence — 777 samples, the promotion
# history, the drift events. It is deliberately NOT in the repository,
# so a fresh clone starts empty and rebuilds by collecting. If you need
# to hand the measured database to someone, ship it as a release asset
# or a Docker volume, not as a commit.
data/

# MLflow's artifact store: serialised models, baseline ladders, run
# metadata. Regenerated by the pipeline; the run history lives in
# data/mlflow.db, which is ignored above.
mlruns/

# --------------------------------------------------------------- graphify
# The knowledge-graph OUTPUTS stay tracked — CLAUDE.md tells every agent
# to read graphify-out/graph.json and GRAPH_REPORT.md for navigation, so
# a clone without them is a clone that navigates by grep. The per-file
# AST and semantic cache is pure recomputation and 85 of the 91 files.
graphify-out/cache/

# ---------------------------------------------------------------- tooling
.idea/
.vscode/
*.code-workspace

*.log
*.tmp
*.bak
.DS_Store
Thumbs.db

# ---------------------------------------------------------------- docker
# Local compose overrides are per-machine by design; docker-compose.yml
# itself IS tracked.
docker-compose.override.yml
.env
