# Copy to `.env` (already gitignored) and fill in from your Supabase
# project. See dashboard/auth.py for how the dashboard uses these, and
# dashboard/sql/ for the one-time database setup they depend on.

# Settings > API. The anon key is the public one — it is safe in a
# browser because `profiles` is behind row level security. Never put the
# service_role key here; it bypasses RLS entirely.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Settings > Database > Connection string (URI). Read only by
# `python -m dashboard.apply_sql`, which creates the tables, policies and
# accounts. The running dashboard never touches it. Percent-encode any
# '@' in the password as %40.
SUPABASE_DB_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
